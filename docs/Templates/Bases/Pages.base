filters:
  and:
    - file.hasTag("page")
    - '!file.name.contains("template")'
views:
  - type: cards
    name: ByCategory
    filters:
      and:
        - Categories.contains(this.file.name.toString())
    order:
      - file.name
    image: note.header image url
    imageFit: cover
    imageAspectRatio: 1.7777777778
    cardSize: 220
